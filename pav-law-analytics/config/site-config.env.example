# Copy to site-config.env and fill in after Phase 1 manual audit.
# Do NOT commit site-config.env if it contains secrets.

GA4_MEASUREMENT_ID=G-4RQMF505EB
GTM_CONTAINER_ID=GTM-XXXXXXX

# From HubSpot Settings → Account & Billing → Account Defaults
HUBSPOT_PORTAL_ID=

# From HubSpot form editor URL after creating intake form
HUBSPOT_FORM_GUID=

# Google Ads — customer ID (API: no dashes). Copy from Ads top bar: 414-638-6147
GOOGLE_ADS_CUSTOMER_ID=4146386147

# Google Ads API (Gilbert A8) — copy from API Center + OAuth flow. Never commit real values.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Optional if account is under an MCC manager
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Audit results (Yes/No)
GTM_ALREADY_ON_SITE=
DIRECT_GA4_ALREADY_ON_SITE=
HUBSPOT_ALREADY_ON_SITE=
DUPLICATE_GA4_RISK=
